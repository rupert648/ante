import Std.String.try_cast_string_i8, try_cast_string_i32, try_cast_string_i64
import Std.String.try_cast_string_u8, try_cast_string_u32, try_cast_string_u64

main () =
    small_signed: Maybe I8 = try_cast "-12"
    default_int: Maybe I32 = try_cast "12345"
    big_signed: Maybe I64 = try_cast "-123456789"

    small_unsigned: Maybe U8 = try_cast "255"
    medium_unsigned: Maybe U32 = try_cast "4294967295"
    big_unsigned: Maybe U64 = try_cast "18446744073709551615"

    too_big_i8: Maybe I8 = try_cast "128"
    negative_u8: Maybe U8 = try_cast "-1"

    println small_signed
    println default_int
    println big_signed
    println small_unsigned
    println medium_unsigned
    println big_unsigned
    println too_big_i8
    println negative_u8

// args: --delete-binary --no-color
// expected stdout:
// Some -12
// Some 12345
// Some -123456789
// Some 255
// Some 4294967295
// Some 18446744073709551615
// None
// None
